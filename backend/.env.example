# ============================================
# TimeBudget — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================

# --- Application ---
SECRET_KEY=change-me-to-a-random-string

# --- MySQL (required). Create the database first: CREATE DATABASE timebudget; ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=timebudget
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=timebudget

# --- Firebase Cloud Messaging (server-side) ---
# Download from Firebase Console > Project Settings > Service accounts > Generate new private key.
# See firebase-service-account.json.example for the expected JSON structure.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# --- Email / SMTP ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TimeBudget
SMTP_USE_TLS=true

# --- Shift Reminder Scheduler ---
SCHEDULER_ENABLED=true
SHIFT_REMINDER_MINUTES=5
SCHEDULER_CHECK_INTERVAL_SECONDS=60
