# ============================================
# TimeBudget — Frontend Environment Variables
# Copy this file to .env and fill in your Firebase values.
# ============================================

# --- Firebase (public client-side config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Cloud Messaging VAPID key ---
# Generate in Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
